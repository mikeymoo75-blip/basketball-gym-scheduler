# Copy this file to .env on the Proxmox VM, then fill in AUTH_SECRET, the
# Cloudflare tunnel token, and ADMIN_PASSWORD.
# Windows hides names that start with a dot — this file is named without one
# so it shows up in File Explorer and WinSCP.

DATABASE_URL="file:./dev.db"
AUTH_SECRET="PASTE_OUTPUT_OF_openssl_rand_-base64_32"
AUTH_URL="https://www.datosfarm.com"
EMAIL_FROM="MP Basketball <noreply@datosfarm.com>"
RESEND_API_KEY=""
CLOUDFLARE_TUNNEL_TOKEN="PASTE_TOKEN_FROM_CLOUDFLARE"
ADMIN_USERNAME=admin
ADMIN_PASSWORD="choose-a-strong-password"
